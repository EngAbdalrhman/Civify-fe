    {
      "name": "civify_parse_cv",
      "title": "Parse Resume Document",
      "description": "Parse a resume document (PDF, DOCX, image) into structured JSON schema containing contact details, work experience, education, skills, and projects. May consume AI credits; do not automatically retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "resume_text": {
            "type": "string",
            "minLength": 1,
            "description": "Complete resume text read from the attachment. Preferred fallback when the client cannot forward bytes. Do not summarize or invent missing content."
          },
          "file_base64": {
            "type": "string",
            "description": "Base64 encoded content of the resume document (PDF, DOCX). Recommended for remote/cloud MCP servers."
          },
          "filename": {
            "type": "string",
            "description": "Original filename for base64 data, including extension (PDF, DOCX, PNG or JPG). Inferred from bytes when omitted."
          },
          "language": {
            "type": "string",
            "description": "Language code (e.g. 'en', 'ar', 'auto'). Default is 'auto'.",
            "default": "auto"
          },
          "file": {
            "type": "object",
            "description": "A user-selected chat attachment supplied by the client. Never invent a download URL or file ID.",
            "properties": {
              "download_url": {
                "type": "string"
              },
              "file_id": {
                "type": "string"
              },
              "mime_type": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              }
            },
            "required": [
              "download_url",
              "file_id"
            ],
            "additionalProperties": false
          },
          "file_url": {
            "type": "string",
            "description": "Actual HTTPS download URL supplied by the client or user. Never use a sandbox path, file ID alone or an invented URL."
          }
        },
        "anyOf": [
          {
            "required": [
              "resume_text"
            ]
          },
          {
            "required": [
              "file_base64"
            ]
          },
          {
            "required": [
              "file"
            ]
          },
          {
            "required": [
              "file_url"
            ]
          }
        ]
      },
      "annotations": {
        "title": "Parse Resume Document",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ]
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "civify:tools"
          ]
        }
      ],
