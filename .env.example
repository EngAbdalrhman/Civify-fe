# HICv Environment Variables Template
# Copy this file to .env.local and fill in your values

# ==================== REQUIRED ====================

# Firebase Configuration (REQUIRED)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Appwrite Configuration (REQUIRED)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
NEXT_PUBLIC_APPWRITE_CVS_COLLECTION_ID=cvs
NEXT_PUBLIC_APPWRITE_LICENSES_COLLECTION_ID=licenses
NEXT_PUBLIC_APPWRITE_API_KEYS_COLLECTION_ID=api_keys
NEXT_PUBLIC_APPWRITE_API_USAGE_LOGS_COLLECTION_ID=api_usage_logs
NEXT_PUBLIC_APPWRITE_BUCKET_ID=cvs

# Appwrite Server API Key (REQUIRED for server-side operations)
APPWRITE_API_KEY=your_server_api_key

# Google Gemini API (REQUIRED for AI features)
GEMINI_API_KEY=your_gemini_api_key

# Application URL (REQUIRED)
NEXT_PUBLIC_APP_URL=http://localhost:9002

# ==================== PAYMENT INTEGRATIONS (OPTIONAL - DISABLED BY DEFAULT) ====================

# Enable/Disable Payment Providers
NEXT_PUBLIC_PAYMOB_ENABLED=false
NEXT_PUBLIC_PAYPAL_ENABLED=false

# Paymob Configuration (Egypt/MENA)
# Get these from: https://paymob.com
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_CARD_INTEGRATION_ID=your_card_integration_id
PAYMOB_WALLET_INTEGRATION_ID=your_wallet_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# PayPal Configuration (International)
# Get these from: https://developer.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox
# Change to 'live' for production
PAYPAL_WEBHOOK_ID=your_webhook_id
# Optional: for webhook signature verification

# ==================== EMAIL NOTIFICATIONS (OPTIONAL - DISABLED BY DEFAULT) ====================

# Enable/Disable Email
NEXT_PUBLIC_EMAIL_ENABLED=false

# Email Provider: smtp, sendgrid, or resend
EMAIL_PROVIDER=smtp

# SMTP Configuration (Gmail or other SMTP)
# For Gmail: Use App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=HICv

# SendGrid Configuration (Alternative to SMTP)
# Get API key from: https://sendgrid.com
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=HICv

# Resend Configuration (Alternative to SMTP)
# Get API key from: https://resend.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=HICv

# ==================== PUSH NOTIFICATIONS (OPTIONAL - DISABLED BY DEFAULT) ====================

# Enable/Disable Push Notifications
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false

# Firebase Cloud Messaging
# Get VAPID key from Firebase Console → Project Settings → Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# ==================== DEVELOPMENT ====================

# Development Mode
NODE_ENV=development

# Port (optional)
PORT=9002

# ==================== PRODUCTION ====================

# For production deployment, set these in your hosting platform (Netlify/Vercel)
# - All NEXT_PUBLIC_* variables
# - APPWRITE_API_KEY
# - GEMINI_API_KEY
# - Payment credentials (if enabled)
# - Email credentials (if enabled)
# - Push notification credentials (if enabled)

# ==================== NOTES ====================

# 1. REQUIRED variables must be set for the app to work
# 2. OPTIONAL variables can be left empty - features will be disabled
# 3. Never commit .env.local to git
# 4. For production, add all variables to your hosting platform's environment settings
# 5. Payment integrations are READY but DISABLED - enable when you have credentials
# 6. Email notifications are READY but DISABLED - enable when you have SMTP/API credentials
# 7. Push notifications are READY but DISABLED - enable when you configure FCM

